# systemd-юнит почтового веб-клиента. Устанавливается deploy/install.sh.
# Переопределения — через `systemctl edit webmail` (drop-in), не правкой этого файла.
[Unit]
Description=Webmail — почтовый веб-клиент
Documentation=https://github.com/ibuben/squareball
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=webmail
Group=webmail
ExecStart=/usr/local/bin/webmail serve -config /etc/webmail/config.yaml
# Переменные WEBMAIL_* (например WEBMAIL_SERVER__LISTEN) — необязательный файл.
EnvironmentFile=-/etc/webmail/webmail.env
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
# /var/lib/webmail — данные (SQLite и т. п.), владелец webmail.
StateDirectory=webmail
StateDirectoryMode=0700
UMask=0077

# Песочница: процессу нужны только сеть и чтение /etc/webmail.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Порт ниже 1024 без reverse proxy:
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Адаптерам, которым нужен доступ к файлам панели, путь открывают drop-in'ом:
#   ReadWritePaths=/var/lib/webbeard/webmail-sso

[Install]
WantedBy=multi-user.target
